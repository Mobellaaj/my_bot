<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">

            <!-- Wheel Information -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.35</wheel_separation>
            <wheel_radius>0.05</wheel_radius>

            <!-- Limits -->
            <!-- Original max_wheel_acceleration = 10 rad/s^2 -->
            <!-- Approximate equivalent: 10 * 0.05 = 0.5 m/s^2 -->
            <max_linear_acceleration>0.5</max_linear_acceleration>
            <min_linear_acceleration>-0.5</min_linear_acceleration>

            <!-- Command Topic -->
            <topic>/cmd_vel</topic>

            <!-- Output -->
            <odom_topic>/odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_publish_frequency>30</odom_publish_frequency>

            <tf_topic>/tf</tf_topic>

        </plugin>

        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>/world/empty/model/my_bot/joint_state</topic>
        </plugin>
    </gazebo>

</robot>