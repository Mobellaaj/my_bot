<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Keep this world name consistent with the existing joint-state bridge. -->
  <world name="empty">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.82 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.3 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <!-- Floor top is z=0. Robot is spawned separately at x=0, y=0. -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.4 8.4 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.4 8.4 0.2</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.72 0.74 0.76 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Approximately 8 x 8 m room; walls overlap at corners. -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.75 1</ambient>
            <diffuse>0.25 0.45 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.4 0.2 1.5</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.75 1</ambient>
            <diffuse>0.25 0.45 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
          <material>
            <ambient>0.82 0.78 0.65 1</ambient>
            <diffuse>0.82 0.78 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8.4 1.5</size></box></geometry>
          <material>
            <ambient>0.82 0.78 0.65 1</ambient>
            <diffuse>0.82 0.78 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Partition x=1: 1.6 m doorway between y=-0.8 and y=0.8. -->
    <model name="partition_north">
      <static>true</static>
      <pose>1 2.4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 3.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.2 1.5</size></box></geometry>
          <material>
            <ambient>0.3 0.65 0.5 1</ambient>
            <diffuse>0.3 0.65 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="partition_south">
      <static>true</static>
      <pose>1 -2.4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 3.2 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.2 1.5</size></box></geometry>
          <material>
            <ambient>0.3 0.65 0.5 1</ambient>
            <diffuse>0.3 0.65 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Asymmetric landmarks, clear of the spawn and doorway approach. -->
    <model name="orange_crate">
      <static>true</static>
      <pose>-2 1.7 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 1.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 1.2 1</size></box></geometry>
          <material>
            <ambient>0.95 0.45 0.12 1</ambient>
            <diffuse>0.95 0.45 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="purple_crate">
      <static>true</static>
      <pose>-1.7 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
          <material>
            <ambient>0.55 0.3 0.7 1</ambient>
            <diffuse>0.55 0.3 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="blue_crate">
      <static>true</static>
      <pose>2.7 2.4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.9 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.9 1</size></box></geometry>
          <material>
            <ambient>0.15 0.55 0.85 1</ambient>
            <diffuse>0.15 0.55 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
